---
// The shell every page shares: head, header, footer.
//
// Before this existed each page carried its own copy, so a change to the nav or
// the meta tags meant editing every file and hoping none was missed. The head is
// driven by props; anything page-specific that does not fit a prop goes through
// the `head` slot.
import '../styles/styles.css';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_CODES,
  alternates,
  dictionary,
  localePath,
  type LocaleCode,
} from '../i18n';

interface Props {
  /** Локаль страницы. Оболочка берёт из неё nav, футер и атрибут lang. */
  locale?: LocaleCode;
  /**
   * Логический путь страницы без префикса локали: '/' или '/support/'.
   * Задан — страница получает матрицу hreflang и переключатель языка.
   * Не задан — страница считается одноязычной (examples, privacy, 404,
   * reset-password), и альтернатив у неё нет: разметка не должна обещать
   * переводы, которых нет.
   */
  page?: string;
  title: string;
  description: string;
  /** 'home' adds the in-page anchors (#features, #faq); everything else in the
   *  header is identical on every page. */
  nav?: 'home' | 'sub';
  /** Marks the current page in the nav. */
  current?: 'examples' | 'support' | 'privacy';
  /** Extra classes on .page — 404 uses page-flex to pin the footer down. */
  pageClass?: string;
  noindex?: boolean;
  /** Open Graph is only worth carrying on pages meant to be shared. */
  og?: { title: string; description: string };
}

const {
  locale = DEFAULT_LOCALE,
  page,
  title,
  description,
  nav = 'sub',
  current,
  pageClass = '',
  noindex = false,
  og,
} = Astro.props;

const t = dictionary(locale);
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Локализованные ссылки. Examples и privacy остаются одноязычными по своим
// нынешним путям — переводить их мы сознательно не стали, поэтому href у них
// абсолютный и одинаковый во всех локалях.
const homeHref = localePath(locale, '/');
const supportHref = localePath(locale, '/support/');

// hreflang и переключатель есть только у страниц, которые действительно переведены.
// Группа обязана быть симметричной — если A ссылается на B, B ссылается на A, —
// поэтому список строится из одного источника и одинаков на всех страницах группы.
const hreflangLinks = page && LOCALE_CODES.length > 1
  ? alternates(page).map((link) => ({
      hreflang: link.hreflang,
      href: new URL(link.path, Astro.site).href,
    }))
  : [];

const languageLinks =
  page && LOCALE_CODES.length > 1
    ? LOCALE_CODES.map((code) => ({
        code,
        name: LOCALES[code].nativeName,
        href: localePath(code, page),
        current: code === locale,
      }))
    : [];
---

<!doctype html>
<html lang={t.hreflang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {og && (
      <>
        <meta property="og:title" content={og.title} />
        <meta property="og:description" content={og.description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Notix — AI Note Taker" />
        {/* Absolute: the scrapers that read these do not resolve relative paths. */}
        <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Notix — turn anything you're learning into notes that teach you back" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={og.title} />
        <meta name="twitter:description" content={og.description} />
        <meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />
      </>
    )}
    <link rel="canonical" href={canonical} />
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <meta name="theme-color" content="#010206" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/assets/fonts/inter-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
    <script>
      import '../scripts/analytics.js';
      // site.js now carries the header burger, which every page has — so it loads
      // from the shell rather than from the two pages that happened to need it.
      import '../scripts/site.js';
      import '../scripts/language.js';
    </script>
  </head>

  <body>
    <div class:list={['page', pageClass]}>
      <!-- The same glow on every page. Sub-pages used to get a single static
           circle at 0.3 alpha against the home page's two animated ones at 0.57
           and 0.21 — so the background visibly dropped in brightness the moment
           you left the home page. One treatment, no jump. -->
      <div class="glow" aria-hidden="true">
        <div class="glow-a"></div>
        <div class="glow-b"></div>
      </div>

      {languageLinks.length > 0 && (
        <>
          {/* Полоска-подсказка вместо серверного редиректа: она не меняет содержимое
              страницы, поэтому краулер видит ровно то же, что человек, и ни одна
              локаль не превращается в дубль. */}
          <div class="lang-hint" data-lang-hint hidden>
            <span data-lang-hint-text></span>
            <a data-lang-hint-cta href="/">{t.languageBanner.cta}</a>
            <button type="button" data-lang-hint-dismiss aria-label={t.languageBanner.dismiss}
              >×</button
            >
          </div>
          <script
            type="application/json"
            data-lang-data
            set:html={JSON.stringify({
              current: locale,
              template: t.languageBanner.text,
              locales: languageLinks.map((link) => ({
                code: link.code,
                name: link.name,
                href: link.href,
              })),
            })}
          />
        </>
      )}

      <header class="site-header">
        <div class="header-inner">
          <a class="logo" href={homeHref}>
            <span class="logo-mark" aria-hidden="true"></span>
            <span class="logo-name">Notix</span>
          </a>
          <!-- One header everywhere. The two variants that used to live here were
               the whole reason the sub-pages felt different: the home nav carried
               the pill button and the sub nav did not, and a pill is taller than a
               text link, so the header changed height on every navigation. Only the
               in-page anchors are conditional now — they have nothing to point at
               off the home page. -->
          <!-- The burger owns the nav below 640px. Everything stays in one <nav>:
               the panel is the same list, re-laid-out by CSS, so there is no second
               copy of the links to keep in sync. -->
          <button class="nav-burger" type="button" aria-label={t.nav.menu} aria-expanded="false"
                  aria-controls="site-nav" data-burger>
            <span></span><span></span><span></span>
          </button>
          <nav class="site-nav" id="site-nav" data-desktop-nav>
            {nav === 'home' && (
              <>
                <a href="#features" class="nav-hide-mobile">{t.nav.features}</a>
                <a href="#faq" class="nav-hide-mobile">{t.nav.faq}</a>
              </>
            )}
            <a href="/examples/" aria-current={current === 'examples' ? 'page' : undefined}
              >{t.nav.examples}</a
            >
            <a href={supportHref} aria-current={current === 'support' ? 'page' : undefined}
              >{t.nav.support}</a
            >
            {languageLinks.length > 0 && (
              <details class="lang-switch">
                <summary aria-label={t.nav.language}>
                  <span class="lang-current">{dictionary(locale).nativeName}</span>
                </summary>
                {/* Настоящие ссылки, а не JS-выпадашка: краулер должен пройти по ним
                    и обнаружить локали — иначе половина смысла hreflang теряется. */}
                <ul class="lang-list">
                  {languageLinks.map((link) => (
                    <li>
                      <a href={link.href} hreflang={link.code} lang={link.code}
                         aria-current={link.current ? 'page' : undefined}>{link.name}</a>
                    </li>
                  ))}
                </ul>
              </details>
            )}
            <a
              class="pill-btn"
              href="https://apps.apple.com/app/id6758561284"
              data-track="app_store_click"
              data-placement="nav">{t.nav.getApp}</a
            >
          </nav>
        </div>
      </header>

      <!-- The panel is a sibling of the header, not a child of it — it drops from
           under the header across the full width and sizes to its content, so it
           cannot live inside the header's row. The scrim below it dims the page
           and closes the menu on tap. -->
      <div class="nav-scrim" data-scrim hidden></div>
      <div class="nav-panel" data-panel-nav>
        <div class="nav-panel-glow" aria-hidden="true"></div>
        <div class="nav-panel-inner">
          {/* The panel mirrors the desktop nav, anchors included — on the home page
              those two are how you reach Features and FAQ, and dropping them from
              the mobile menu would leave the sections unreachable on a phone. */}
          {nav === 'home' && (
            <>
              <a href="#features">{t.nav.features}</a>
              <a href="#faq">{t.nav.faq}</a>
            </>
          )}
          <a href="/examples/">{t.nav.examples}</a>
          <a href={supportHref}>{t.nav.support}</a>
          <a
            class="btn-primary nav-panel-cta"
            href="https://apps.apple.com/app/id6758561284"
            data-track="app_store_click"
            data-placement="mobile_nav">{t.nav.getApp}</a
          >
          {languageLinks.length > 0 && (
            <div class="nav-panel-langs">
              {/* На телефоне переключателя в шапке нет — он здесь, иначе языки
                  становятся недостижимы на самом частом устройстве. */}
              {languageLinks.map((link) => (
                <a href={link.href} hreflang={link.code} lang={link.code}
                   aria-current={link.current ? 'page' : undefined}>{link.name}</a>
              ))}
            </div>
          )}
          <div class="nav-panel-foot">
            <div>
              <a href="/privacy/">{t.footer.privacy}</a>
              <a href="mailto:support@notix-ai.app">support@notix-ai.app</a>
            </div>
            <span>{t.footer.copyright}</span>
          </div>
        </div>
      </div>

      <slot />

      <footer class="site-footer">
        <div class="footer-inner">
          <div class="footer-links">
            <a href="/examples/">{t.nav.examples}</a>
            <a href={supportHref}>{t.nav.support}</a>
            <a href="/privacy/">{t.footer.privacy}</a>
            <a href="mailto:support@notix-ai.app">support@notix-ai.app</a>
          </div>
          <div class="footer-copy">{t.footer.copyright}</div>
        </div>
      </footer>
    </div>
  </body>
</html>
