---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — Notix"
  description="Page not found — Notix. The page you are looking for does not exist or has moved."
  pageClass="page-flex"
  noindex
>
  <main class="notfound-main">
    <div class="notfound-inner">
      <img class="notfound-cat" src="/assets/cat_happy.svg" alt="" width="120" height="120">
      <h1>404 — this page took <em>no notes</em></h1>
      <p>The page you're looking for doesn't exist or has moved.</p>
      <a class="btn-primary" href="/">Back to home</a>
    </div>
  </main>

  
</Base>
