---
import Base from '../layouts/Base.astro';
import { DEFAULT_LOCALE, dictionary } from '../i18n';

const locale = DEFAULT_LOCALE;
const t = dictionary(locale).notFound;
---

<Base
  locale={locale}
  title={t.seoTitle}
  description={t.seoDescription}
  pageClass="page-flex"
  noindex
>
  <main class="notfound-main">
    <div class="notfound-inner">
      <img class="notfound-cat" src="/assets/cat_happy.svg" alt="" width="120" height="120">
      <h1>{t.titleLead} <em>{t.titleEmphasis}</em></h1>
      <p>{t.text}</p>
      <a class="btn-primary" href="/">{t.cta}</a>
    </div>
  </main>


</Base>
