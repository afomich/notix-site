---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const examples = await getCollection('examples');
  return examples.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const processed = d.processedOn.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const INPUT_LABEL: Record<string, string> = {
  lecture: 'Recorded lecture',
  pdf: 'PDF document',
  video: 'Video link',
  audio: 'Audio upload',
  article: 'Web article',
};
---

<Base
  current="examples"
  title={d.seoTitle ? `${d.seoTitle} — Notix` : `${d.title} — Notix example`}
  description={d.description}
  og={{ title: d.seoTitle ?? d.title, description: d.description }}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LearningResource',
      name: d.title,
      description: d.description,
      about: d.subject,
      dateCreated: d.processedOn.toISOString().slice(0, 10),
      isBasedOn: { '@type': 'CreativeWork', name: d.source.name, url: d.source.url },
      license: d.source.licenceUrl ?? undefined,
      publisher: { '@type': 'Organization', name: 'Notix' },
    })} />

  </Fragment>

  <main class="page-main ex">
    <p class="ex-crumb"><a href="/examples/">Examples</a> · {d.subject}</p>
    <h1>{d.title}</h1>
    <p class="ex-lede">{d.description}</p>

    <!-- Provenance sits above the output and outside the tabs on purpose: a summary
         is only worth anything if you can see what it was made from, so the source
         must never be one click away. -->
    <section class="ex-source">
      <p class="ex-source-eyebrow">Source</p>
      <p class="ex-source-name">
        <a href={d.source.url} rel="noopener" target="_blank">{d.source.name}</a>
      </p>
      <div class="ex-source-meta">
        <div><span>Publisher</span><b>{d.source.publisher}</b></div>
        <div>
          <span>Licence</span>
          <b>{d.source.licenceUrl
            ? <a href={d.source.licenceUrl} rel="noopener nofollow" target="_blank">{d.source.licence}</a>
            : d.source.licence}</b>
        </div>
        <div><span>Extent</span><b>{d.source.extent}</b></div>
        <div><span>Given to Notix as</span><b>{INPUT_LABEL[d.inputType]}</b></div>
        <div><span>Processed</span><b>{processed}, app {d.appVersion}</b></div>
      </div>
    </section>

    <section class="ex-block">
      <h2 class="ex-h">Source, first paragraphs</h2>
      <blockquote class="ex-transcript">{d.transcriptExcerpt}</blockquote>
      <p class="ex-note">An excerpt. Notix worked from the full material.</p>
    </section>

    <!-- Tabs are progressive enhancement. All three panels render server-side and
         stay in the DOM; the script only sets `hidden` on the inactive two. That is
         what keeps them crawlable, deep-linkable and printable — and what makes the
         no-JS fallback correct (everything visible) rather than empty. -->
    <div class="ex-tabs" data-tabbar role="tablist" aria-label="Example output">
      <button type="button" role="tab" data-tab="summary" aria-controls="summary">Summary</button>
      <button type="button" role="tab" data-tab="flashcards" aria-controls="flashcards"
        >Flashcards <span class="ex-count">{d.flashcards.length}</span></button
      >
      <button type="button" role="tab" data-tab="quiz" aria-controls="quiz"
        >Quiz <span class="ex-count">{d.quiz.length}</span></button
      >
    </div>

    <section class="ex-block" id="summary" data-panel>
      <h2 class="ex-h">Summary Notix produced</h2>
      <div class="ex-summary"><Content /></div>
    </section>

    <section class="ex-block" id="flashcards" data-panel>
      <h2 class="ex-h">Flashcards <span class="ex-count">{d.flashcards.length}</span></h2>
      <div class="ex-cards">
        {d.flashcards.map((c) => (
          <div class="ex-card" tabindex="0" role="button" aria-label={`Flashcard: ${c.front}`}>
            <div class="ex-card-inner">
              <div class="ex-card-face ex-card-front">
                <p>{c.front}</p>
                <span class="ex-flip-hint"><span aria-hidden="true">⇄</span> Tap to flip</span>
              </div>
              <div class="ex-card-face ex-card-back">
                <span class="ex-card-eyebrow">Answer</span>
                <p>{c.back}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="ex-block" id="quiz" data-panel>
      <h2 class="ex-h">Quiz <span class="ex-count">{d.quiz.length}</span></h2>
      <ol class="ex-quiz">
        {d.quiz.map((q) => (
          <li>
            <p class="ex-q">{q.question}</p>
            <ul>
              {q.options.map((o, i) => (
                <li class={i === q.answer ? 'ex-right' : ''}>
                  <span>{o}</span>
                  {i === q.answer && (
                    <img src="/assets/icons/check.svg" alt="Correct answer"
                         width="15" height="15" class="ex-check" />
                  )}
                </li>
              ))}
            </ul>
            <p class="ex-why">{q.explanation}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="ex-cta">
      <h2>Do this with your own lecture</h2>
      <p>Everything above was generated from the source, unedited.</p>
      <a
        class="btn-primary"
        href="https://apps.apple.com/app/id6758561284"
        data-track="app_store_click"
        data-placement="example">Download on the App Store</a
      >
    </section>
  </main>
</Base>
