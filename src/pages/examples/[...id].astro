---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const examples = await getCollection('examples');
  return examples.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const processed = d.processedOn.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const INPUT_LABEL: Record<string, string> = {
  lecture: 'Recorded lecture',
  pdf: 'PDF document',
  video: 'Video link',
  audio: 'Audio upload',
  article: 'Web article',
};
---

<Base title={`${d.title} — Notix example`} description={d.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LearningResource',
      name: d.title,
      description: d.description,
      about: d.subject,
      dateCreated: d.processedOn.toISOString().slice(0, 10),
      isBasedOn: { '@type': 'CreativeWork', name: d.source.name, url: d.source.url },
      license: d.source.licenceUrl ?? undefined,
      publisher: { '@type': 'Organization', name: 'Notix' },
    })} />
  </Fragment>

  <main class="page-main ex">
    <p class="ex-crumb"><a href="/examples/">Examples</a> · {d.subject}</p>
    <h1>{d.title}</h1>
    <p class="ex-lede">{d.description}</p>

    <!-- The provenance block sits above the output on purpose: a summary is only
         worth anything if you can see what it was made from. -->
    <section class="ex-source">
      <h2>Source</h2>
      <dl>
        <div><dt>Material</dt><dd><a href={d.source.url} rel="noopener" target="_blank">{d.source.name}</a></dd></div>
        <div><dt>Publisher</dt><dd>{d.source.publisher}</dd></div>
        <div><dt>Licence</dt><dd>
          {d.source.licenceUrl
            ? <a href={d.source.licenceUrl} rel="noopener nofollow" target="_blank">{d.source.licence}</a>
            : d.source.licence}
        </dd></div>
        <div><dt>Extent</dt><dd>{d.source.extent}</dd></div>
        <div><dt>Given to Notix as</dt><dd>{INPUT_LABEL[d.inputType]}</dd></div>
        <div><dt>Processed</dt><dd>{processed}, app {d.appVersion}</dd></div>
      </dl>
    </section>

    <section class="ex-block">
      <h2>Transcript, first minutes</h2>
      <blockquote class="ex-transcript">{d.transcriptExcerpt}</blockquote>
      <p class="ex-note">An excerpt. Notix worked from the full material.</p>
    </section>

    <section class="ex-block">
      <h2>Summary Notix produced</h2>
      <div class="ex-summary"><Content /></div>
    </section>

    <section class="ex-block">
      <h2>Flashcards <span class="ex-count">{d.flashcards.length}</span></h2>
      <div class="ex-cards">
        {d.flashcards.map((c) => (
          <details class="ex-card">
            <summary>{c.front}</summary>
            <div><p>{c.back}</p></div>
          </details>
        ))}
      </div>
    </section>

    <section class="ex-block">
      <h2>Quiz <span class="ex-count">{d.quiz.length}</span></h2>
      <ol class="ex-quiz">
        {d.quiz.map((q) => (
          <li>
            <p class="ex-q">{q.question}</p>
            <ul>
              {q.options.map((o, i) => (
                <li class={i === q.answer ? 'ex-right' : ''}>{o}</li>
              ))}
            </ul>
            <p class="ex-why">{q.explanation}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="ex-cta">
      <h2>Do this with your own lecture</h2>
      <p>Everything above was generated from the source, unedited.</p>
      <a
        class="btn-primary"
        href="https://apps.apple.com/app/id6758561284"
        data-track="app_store_click"
        data-placement="example">Download on the App Store</a
      >
    </section>
  </main>
</Base>
