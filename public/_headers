# Cloudflare reads this file. Rules are additive: when two patterns match the same
# path, Cloudflare appends both values rather than letting the later one win, so a
# catch-all Cache-Control would concatenate with every specific one and produce a
# malformed header. The patterns below therefore never overlap on Cache-Control —
# the catch-all carries security headers only.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fingerprinted by the build: the filename changes whenever the contents do, so a
# deploy can never serve a stale one.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable but not fingerprinted, so a day rather than forever.
/assets/*
  Cache-Control: public, max-age=86400

# Apple parses the AASA only when it is served as JSON; the file has no extension
# so the default content-type would be octet-stream.
/.well-known/apple-app-site-association
  Content-Type: application/json
